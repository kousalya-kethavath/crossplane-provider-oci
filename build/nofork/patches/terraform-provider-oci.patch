new file mode 100644
index 00000000..bb35a437
--- /dev/null
+++ b/oci/provider_test.go
@@ -0,0 +1,99 @@
+// Copyright (c) 2026, Oracle and/or its affiliates.
+// Licensed under the Mozilla Public License Version 2.0
+
+package oci
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestProviderForResources(t *testing.T) {
+	want := []string{"oci_events_rule", "oci_core_vcn"}
+	first, err := ProviderForResources(want...)
+	if err != nil {
+		t.Fatalf("ProviderForResources() error = %v", err)
+	}
+	if len(first.ResourcesMap) != len(want) {
+		t.Fatalf("ProviderForResources() returned %d resources, want %d", len(first.ResourcesMap), len(want))
+	}
+	if len(first.DataSourcesMap) != 0 {
+		t.Fatalf("ProviderForResources() returned %d data sources, want 0", len(first.DataSourcesMap))
+	}
+	for _, name := range want {
+		if first.ResourcesMap[name] == nil {
+			t.Errorf("ProviderForResources() omitted %q", name)
+		}
+	}
+	if first.ResourcesMap["oci_identity_tag_namespace"] != nil {
+		t.Error("ProviderForResources() included an unrequested resource")
+	}
+
+	second, err := ProviderForResources(want...)
+	if err != nil {
+		t.Fatalf("second ProviderForResources() error = %v", err)
+	}
+	first.ResourcesMap[want[0]].Schema["description"].Description = "mutated"
+	if second.ResourcesMap[want[0]].Schema["description"].Description == "mutated" {
+		t.Error("ProviderForResources() returned shared resource schemas")
+	}
+
+	if _, err := ProviderForResources("oci_not_a_registered_resource"); err == nil {
+		t.Error("ProviderForResources() error = nil for an unknown resource")
+	}
+}
+
+func TestMetadataClientServices(t *testing.T) {
+	tests := map[string]struct {
+		resourceType string
+		want         []string
+		wantErr      bool
+	}{
+		"core": {
+			resourceType: "oci_core_instance",
+			want:         []string{"core"},
+		},
+		"longest service prefix": {
+			resourceType: "oci_database_management_managed_database",
+			want:         []string{"databasemanagement"},
+		},
+		"normalized object storage name": {
+			resourceType: "oci_objectstorage_bucket",
+			want:         []string{"objectstorage"},
+		},
+		"container instances also requires core": {
+			resourceType: "oci_container_instances_container_instance",
+			want:         []string{"containerinstances", "core"},
+		},
+		"file storage also requires core": {
+			resourceType: "oci_file_storage_file_system",
+			want:         []string{"core", "filestorage"},
+		},
+		"invalid provider prefix": {
+			resourceType: "aws_instance",
+			wantErr:      true,
+		},
+		"unknown service": {
+			resourceType: "oci_not_a_service_resource",
+			wantErr:      true,
+		},
+	}
+
+	for name, tc := range tests {
+		t.Run(name, func(t *testing.T) {
+			got, err := MetadataClientServices(tc.resourceType)
+			if tc.wantErr {
+				if err == nil {
+					t.Fatal("MetadataClientServices() error = nil, want error")
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("MetadataClientServices() error = %v", err)
+			}
+			if !reflect.DeepEqual(got, tc.want) {
+				t.Fatalf("MetadataClientServices() = %v, want %v", got, tc.want)
+			}
+		})
+	}
+}
