+func TestUnit_ProviderInstancesAreIsolated(t *testing.T) {
+	first := Provider()
+	second := Provider()
+	if first == second {
+		t.Fatal("Provider returned a shared instance")
+	}
+
+	for resourceName, firstResource := range first.ResourcesMap {
+		secondResource := second.ResourcesMap[resourceName]
+		if firstResource == nil || secondResource == nil || len(firstResource.Schema) == 0 {
+			continue
+		}
+		if firstResource == secondResource {
+			t.Fatalf("resource %q is shared between provider instances", resourceName)
+		}
+
+		for fieldName, firstField := range firstResource.Schema {
+			secondField := secondResource.Schema[fieldName]
+			if firstField == nil || secondField == nil {
+				continue
+			}
+			if firstField == secondField {
+				t.Fatalf("resource %q field %q is shared between provider instances", resourceName, fieldName)
+			}
+			firstField.Description = "mutated provider instance"
+			if secondField.Description == firstField.Description {
+				t.Fatalf("mutating resource %q field %q affected another provider instance", resourceName, fieldName)
+			}
+			delete(first.ResourcesMap, resourceName)
+			if second.ResourcesMap[resourceName] == nil {
+				t.Fatalf("deleting resource %q affected another provider instance", resourceName)
+			}
+			return
+		}
+	}
+	t.Fatal("could not find a provider resource schema to test")
+}
+
+func TestUnit_MetadataProviderOmitsResourceSchemas(t *testing.T) {
+	p := MetadataProvider()
+	if len(p.ResourcesMap) != 0 || len(p.DataSourcesMap) != 0 {
+		t.Fatal("MetadataProvider constructed resource or data-source schemas")
+	}
+	if len(p.Schema) == 0 {
+		t.Fatal("MetadataProvider returned an empty provider configuration schema")
+	}
+	if p.ConfigureFunc == nil {
+		t.Fatal("MetadataProvider returned no ConfigureFunc")
+	}
+}
