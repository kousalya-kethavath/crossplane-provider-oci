new file mode 100644
index 00000000..1fd2c3a4
--- /dev/null
+++ b/internal/provider/crossplaneservices/scope.go
@@ -0,0 +1,31 @@
+// Copyright (c) 2026, Oracle and/or its affiliates.
+// Licensed under the Mozilla Public License v2.0
+
+package crossplaneservices
+
+import (
+	"strings"
+
+	"github.com/oracle/oci-go-sdk/v65/common"
+)
+
+// Scope is set at link time for Crossplane service-provider
+// binaries. An empty value preserves Terraform Provider OCI's normal behavior
+// of registering every service.
+var Scope string
+
+// CheckForEnabledServices scopes Terraform schema registration without
+// changing the OCI SDK's process-wide enabled-services map. SDK client
+// construction must remain independent because one Terraform service can use
+// clients from several OCI SDK services.
+func CheckForEnabledServices(service string) bool {
+	if scope := strings.TrimSpace(Scope); scope != "" {
+		for candidate := range strings.SplitSeq(scope, ",") {
+			if strings.TrimSpace(candidate) == service {
+				return common.CheckForEnabledServices(service)
+			}
+		}
+		return false
+	}
+	return common.CheckForEnabledServices(service)
+}
diff --git a/internal/provider/crossplaneservices/scope_test.go b/internal/provider/crossplaneservices/scope_test.go
new file mode 100644
index 00000000..5db1094e
--- /dev/null
+++ b/internal/provider/crossplaneservices/scope_test.go
@@ -0,0 +1,44 @@
+// Copyright (c) 2026, Oracle and/or its affiliates.
+// Licensed under the Mozilla Public License v2.0
+
+package crossplaneservices
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/oracle/oci-go-sdk/v65/common"
+)
+
+func TestCheckForEnabledServicesDoesNotRestrictSDKClients(t *testing.T) {
+	originalScope := Scope
+	Scope = "events"
+	t.Cleanup(func() { Scope = originalScope })
+
+	// Initialize and snapshot the OCI SDK map. Crossplane schema scoping must
+	// never add to it, because a non-empty map rejects shared SDK clients.
+	_ = common.CheckForEnabledServices("identity")
+	common.OciSdkEnabledServicesMu.RLock()
+	before := make(map[string]bool, len(common.OciSdkEnabledServicesMap))
+	for service, enabled := range common.OciSdkEnabledServicesMap {
+		before[service] = enabled
+	}
+	common.OciSdkEnabledServicesMu.RUnlock()
+
+	if !CheckForEnabledServices("events") {
+		t.Fatal("scoped service events was disabled")
+	}
+	if CheckForEnabledServices("core") {
+		t.Fatal("out-of-scope service core was enabled")
+	}
+
+	common.OciSdkEnabledServicesMu.RLock()
+	after := make(map[string]bool, len(common.OciSdkEnabledServicesMap))
+	for service, enabled := range common.OciSdkEnabledServicesMap {
+		after[service] = enabled
+	}
+	common.OciSdkEnabledServicesMu.RUnlock()
+	if !reflect.DeepEqual(after, before) {
+		t.Fatalf("OCI SDK enabled-services map changed: before=%v after=%v", before, after)
+	}
+}
