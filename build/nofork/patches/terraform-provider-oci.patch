diff --git a/oci/provider.go b/oci/provider.go
new file mode 100644
index 00000000..04c106f7
--- /dev/null
+++ b/oci/provider.go
@@ -0,0 +1,87 @@
+// Copyright (c) 2024, Oracle and/or its affiliates.
+// Licensed under the Mozilla Public License Version 2.0
+
+package oci
+
+import (
+	"context"
+	"fmt"
+	"sort"
+	"strings"
+
+	fwprovider "github.com/hashicorp/terraform-plugin-framework/provider"
+	"github.com/hashicorp/terraform-plugin-sdk/v2/helper/schema"
+	sdkterraform "github.com/hashicorp/terraform-plugin-sdk/v2/terraform"
+	internalprovider "github.com/oracle/terraform-provider-oci/internal/provider"
+)
+
+var additionalClientServices = map[string][]string{
+	"containerinstances": {"core"},
+	"filestorage":        {"core"},
+}
+
+// Provider returns a fresh SDKv2 provider instance.
+func Provider() *schema.Provider {
+	return internalprovider.Provider()
+}
+
+// ProviderForResources returns a fresh SDKv2 provider containing only the
+// requested managed-resource schemas and no Terraform data-source schemas.
+func ProviderForResources(resourceNames ...string) (*schema.Provider, error) {
+	return internalprovider.ProviderForResources(resourceNames...)
+}
+
+// New returns a fresh Plugin Framework provider instance.
+func New() fwprovider.Provider {
+	return internalprovider.New()
+}
+
+// ConfigureMeta configures only the OCI provider runtime metadata. Unlike
+// Provider, it does not construct resource or data-source schemas.
+func ConfigureMeta(ctx context.Context, raw map[string]any, terraformResourceType string) (any, error) {
+	services, err := MetadataClientServices(terraformResourceType)
+	if err != nil {
+		return nil, err
+	}
+	p := internalprovider.MetadataProvider(services...)
+	diags := p.Configure(ctx, sdkterraform.NewResourceConfigRaw(raw))
+	if diags.HasError() {
+		return nil, fmt.Errorf("cannot configure OCI provider: %v", diags)
+	}
+	meta := p.Meta()
+	if meta == nil {
+		return nil, fmt.Errorf("OCI provider Configure succeeded but returned nil meta")
+	}
+	return meta, nil
+}
+
+// MetadataClientServices returns the normalized OCI service names whose SDK
+// clients are required by a Terraform resource.
+func MetadataClientServices(terraformResourceType string) ([]string, error) {
+	resourceName := strings.TrimPrefix(terraformResourceType, "oci_")
+	if resourceName == terraformResourceType || resourceName == "" {
+		return nil, fmt.Errorf("invalid OCI Terraform resource type %q", terraformResourceType)
+	}
+	normalizedResourceName := strings.ReplaceAll(resourceName, "_", "")
+
+	var primary string
+	for _, service := range internalprovider.RegisteredClientServices() {
+		if strings.HasPrefix(normalizedResourceName, service) && len(service) > len(primary) {
+			primary = service
+		}
+	}
+	if primary == "" {
+		return nil, fmt.Errorf("cannot determine OCI client service for Terraform resource type %q", terraformResourceType)
+	}
+
+	serviceSet := map[string]struct{}{primary: {}}
+	for _, service := range additionalClientServices[primary] {
+		serviceSet[service] = struct{}{}
+	}
+	services := make([]string, 0, len(serviceSet))
+	for service := range serviceSet {
+		services = append(services, service)
+	}
+	sort.Strings(services)
+	return services, nil
+}
