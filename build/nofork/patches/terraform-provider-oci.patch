+
+func TestCreateDbBackupClientInRegionDoesNotMutatePrimaryClient(t *testing.T) {
+	privateKey, err := rsa.GenerateKey(rand.Reader, 1024)
+	if err != nil {
+		t.Fatalf("generate test private key: %v", err)
+	}
+	configProvider := mysqlEndpointTestConfiguration{privateKey: privateKey}
+	primary, err := oci_mysql.NewDbBackupsClientWithConfigurationProvider(configProvider)
+	if err != nil {
+		t.Fatalf("create primary MySQL backup client: %v", err)
+	}
+	primary.UserAgent = "primary-client"
+	primaryHost := primary.Host
+
+	crud := &MysqlMysqlBackupResourceCrud{
+		Client: &primary,
+		ConfigureClient: tf_client.ConfigureClient(func(client *oci_common.BaseClient) error {
+			client.UserAgent = "copy-client"
+			return nil
+		}),
+	}
+	copyClient, err := crud.createDbBackupClientInRegion("us-phoenix-1")
+	if err != nil {
+		t.Fatalf("create copy client: %v", err)
+	}
+
+	if copyClient == crud.Client {
+		t.Fatal("copy operation reused the primary MySQL backup client")
+	}
+	if got := copyClient.UserAgent; got != "copy-client" {
+		t.Fatalf("copy client user agent = %q, want ProviderConfig callback value", got)
+	}
+	if got := crud.Client.UserAgent; got != "primary-client" {
+		t.Fatalf("primary client user agent changed to %q", got)
+	}
+	if got := crud.Client.Host; got != primaryHost {
+		t.Fatalf("primary client host changed from %q to %q", primaryHost, got)
+	}
+	if got := copyClient.Host; got == primaryHost {
+		t.Fatalf("copy client host = %q, want regional endpoint distinct from primary", got)
+	}
+}
+
+type mysqlEndpointTestConfiguration struct {
+	privateKey *rsa.PrivateKey
+}
+
+func (c mysqlEndpointTestConfiguration) PrivateRSAKey() (*rsa.PrivateKey, error) {
+	return c.privateKey, nil
+}
+
+func (mysqlEndpointTestConfiguration) KeyID() (string, error) {
+	return "tenancy/user/fingerprint", nil
+}
+
+func (mysqlEndpointTestConfiguration) TenancyOCID() (string, error) {
+	return "tenancy", nil
+}
+
+func (mysqlEndpointTestConfiguration) UserOCID() (string, error) {
+	return "user", nil
+}
+
+func (mysqlEndpointTestConfiguration) KeyFingerprint() (string, error) {
+	return "fingerprint", nil
+}
+
+func (mysqlEndpointTestConfiguration) Region() (string, error) {
+	return "us-ashburn-1", nil
+}
+
+func (mysqlEndpointTestConfiguration) AuthType() (oci_common.AuthConfig, error) {
+	return oci_common.AuthConfig{AuthType: oci_common.UserPrincipal}, nil
+}
