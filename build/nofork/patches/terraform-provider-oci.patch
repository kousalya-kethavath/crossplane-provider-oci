+var configureClientRegistry sync.Map
+
+func configurationProviderKey(configProvider oci_common.ConfigurationProvider) string {
+	if configProvider == nil {
+		return ""
+	}
+	v := reflect.ValueOf(configProvider)
+	if v.IsValid() && v.Kind() == reflect.Pointer && !v.IsNil() {
+		return fmt.Sprintf("%T:%p", configProvider, v.Interface())
+	}
+	return fmt.Sprintf("%T:%v", configProvider, configProvider)
+}
+
+func (m *OracleClients) setConfigureClient(configProvider oci_common.ConfigurationProvider, configureClient ConfigureClient) {
+	m.ConfigureClient = configureClient
+	if key := configurationProviderKey(configProvider); key != "" && configureClient != nil {
+		configureClientRegistry.Store(key, configureClient)
+	}
+}
+
+func (m *OracleClients) ConfigureBaseClient(client *oci_common.BaseClient) error {
+	if m != nil && m.ConfigureClient != nil {
+		return m.ConfigureClient(client)
+	}
+	return fmt.Errorf("cannot configure OCI client: no configure client is registered")
+}
+
+func ConfigureClientForConfigurationProvider(configProvider oci_common.ConfigurationProvider, client *oci_common.BaseClient) error {
+	if key := configurationProviderKey(configProvider); key != "" {
+		if configureClient, ok := configureClientRegistry.Load(key); ok {
+			return configureClient.(ConfigureClient)(client)
+		}
+	}
+	return fmt.Errorf("cannot configure OCI client: no configure client is registered")
+}
