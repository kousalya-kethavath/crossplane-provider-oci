new file mode 100644
index 00000000..cfd1950b
--- /dev/null
+++ b/internal/provider/workload_identity_federation.go
@@ -0,0 +1,103 @@
+// Copyright (c) 2024, Oracle and/or its affiliates.
+// Licensed under the Mozilla Public License v2.0
+
+package provider
+
+import (
+	"fmt"
+	"os"
+	"strings"
+
+	oci_common "github.com/oracle/oci-go-sdk/v65/common"
+	oci_common_auth "github.com/oracle/oci-go-sdk/v65/common/auth"
+
+	"github.com/oracle/terraform-provider-oci/internal/globalvar"
+)
+
+type fileTokenIssuer struct {
+	path string
+}
+
+func (i fileTokenIssuer) GetToken() (string, error) {
+	tokenBytes, err := os.ReadFile(i.path)
+	if err != nil {
+		return "", err
+	}
+	token := strings.TrimSpace(string(tokenBytes))
+	if token == "" {
+		return "", fmt.Errorf("%s is empty", globalvar.WorkloadIdentityTokenPathAttrName)
+	}
+	return token, nil
+}
+
+type workloadIdentityFederationSettings struct {
+	TokenPath          string
+	DomainURL          string
+	AuthMethod         string
+	ClientID           string
+	ClientSecret       string
+	Region             string
+	RequestedTokenType string
+	SubjectTokenType   string
+	ResourceType       string
+	RPSTExpiration     string
+	PublicKey          string
+}
+
+func workloadIdentityFederationConfigProvider(settings workloadIdentityFederationSettings) (oci_common.ConfigurationProvider, error) {
+	if settings.TokenPath == "" {
+		return nil, fmt.Errorf("%s must be provided when auth is %s", globalvar.WorkloadIdentityTokenPathAttrName, globalvar.AuthWorkloadIdentityFederation)
+	}
+	if settings.DomainURL == "" {
+		return nil, fmt.Errorf("%s must be provided when auth is %s", globalvar.TokenExchangeDomainURLAttrName, globalvar.AuthWorkloadIdentityFederation)
+	}
+	if settings.Region == "" {
+		return nil, fmt.Errorf("%s must be provided when auth is %s", globalvar.RegionAttrName, globalvar.AuthWorkloadIdentityFederation)
+	}
+	if settings.RequestedTokenType == "" {
+		return nil, fmt.Errorf("%s must be provided when auth is %s", globalvar.TokenExchangeRequestedTokenTypeAttrName, globalvar.AuthWorkloadIdentityFederation)
+	}
+	if settings.RequestedTokenType == "urn:oci:token-type:oci-rpst" && settings.ResourceType == "" {
+		return nil, fmt.Errorf("%s must be provided when %s is urn:oci:token-type:oci-rpst", globalvar.TokenExchangeResourceTypeAttrName, globalvar.TokenExchangeRequestedTokenTypeAttrName)
+	}
+
+	builder := oci_common_auth.TokenExchangeBuilder{
+		DomainUrl:          settings.DomainURL,
+		Region:             settings.Region,
+		RequestedTokenType: settings.RequestedTokenType,
+		SubjectTokenType:   settings.SubjectTokenType,
+		ResType:            settings.ResourceType,
+		RpstExp:            settings.RPSTExpiration,
+		PublicKey:          settings.PublicKey,
+	}
+
+	authMethod := strings.TrimSpace(settings.AuthMethod)
+	if authMethod == "" {
+		authMethod = globalvar.TokenExchangeAuthOAuthClientCredentials
+	}
+
+	switch {
+	case strings.EqualFold(authMethod, globalvar.TokenExchangeAuthOAuthClientCredentials):
+		if settings.ClientID == "" || settings.ClientSecret == "" {
+			return nil, fmt.Errorf("%s and %s must be provided when %s is %s", globalvar.TokenExchangeClientIDAttrName, globalvar.TokenExchangeClientSecretAttrName, globalvar.TokenExchangeAuthAttrName, globalvar.TokenExchangeAuthOAuthClientCredentials)
+		}
+		builder.ClientId = settings.ClientID
+		builder.ClientSecret = settings.ClientSecret
+	case strings.EqualFold(authMethod, globalvar.TokenExchangeAuthInstancePrincipal):
+		if settings.ClientID != "" || settings.ClientSecret != "" {
+			return nil, fmt.Errorf("%s and %s must not be provided when %s is %s", globalvar.TokenExchangeClientIDAttrName, globalvar.TokenExchangeClientSecretAttrName, globalvar.TokenExchangeAuthAttrName, globalvar.TokenExchangeAuthInstancePrincipal)
+		}
+		instancePrincipalProvider, err := oci_common_auth.InstancePrincipalConfigurationProvider()
+		if err != nil {
+			return nil, fmt.Errorf("can not get instance principal provider for workload identity federation %v", err)
+		}
+		builder.InstancePrincipalProvider = instancePrincipalProvider
+	default:
+		return nil, fmt.Errorf("%s must be one of %q or %q", globalvar.TokenExchangeAuthAttrName, globalvar.TokenExchangeAuthOAuthClientCredentials, globalvar.TokenExchangeAuthInstancePrincipal)
+	}
+
+	return oci_common_auth.TokenExchangeConfigurationProviderFromIssuer(
+		fileTokenIssuer{path: settings.TokenPath},
+		builder,
+	)
+}
